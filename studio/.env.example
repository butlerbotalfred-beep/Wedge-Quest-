# Copy this file to ".env" (same folder) and fill in what you want.
# Lines starting with # are ignored. Nothing here is required: with no key the
# game uses its built-in questions, and the voice works without any settings.

# Claude writes the questions when a key is set.
# Make a key at https://console.anthropic.com (Settings, API keys). An API key is
# separate from a Claude chat subscription and is billed by use.
ANTHROPIC_API_KEY=

# Which Claude model writes the questions (default: claude-opus-5-5).
# Faster and cheaper choices: claude-sonnet-5-5 or claude-haiku-5-5.
# WQ_MODEL=claude-opus-5-5

# A safety net: the most question requests the server will make in one day (default 300).
# WQ_DAILY_LIMIT=300

# The voice that reads questions aloud (default af_heart).
# American: af_heart af_bella af_nicole af_sarah af_aoede af_kore am_michael am_fenrir am_puck
# British:  bf_emma bm_george bm_fable
# WQ_VOICE=af_heart

# Set to "off" to skip the studio voice and use each device's own voices instead.
# WQ_VOICE_ENGINE=kokoro

# The port the game is served on (default 8777).
# WQ_PORT=8777

# Who may connect. Leave this out so every device on your home network can; 127.0.0.1 means this Mac only.
# WQ_HOST=127.0.0.1

# Started at login (./autostart.command), the game reads this file and nothing else: a key exported in
# your shell profile is not seen. After changing it, run ./autostart.command restart.
