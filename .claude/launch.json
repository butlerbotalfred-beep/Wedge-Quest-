{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wedge-quest",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "dist",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "fake-claude",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "studio/tests/fake_claude.py",
        "8790"
      ],
      "port": 8790
    },
    {
      "name": "wedge-quest-studio",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--script",
        "studio/server.py",
        "--local",
        "--port",
        "8777"
      ],
      "port": 8777
    },
    {
      "name": "wedge-quest-studio-lan",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "caffeinate -i -w $$ & exec env WQ_VOICE_ENGINE=off uv run --script studio/server.py --port 8777"
      ],
      "port": 8777
    }
  ]
}
